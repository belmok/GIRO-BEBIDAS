<UserControl x:Class="GiroBebidas.App.ReportsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GiroBebidas.App" Loaded="Panel_Loaded">
 <UserControl.Resources>
  <local:CashCardColumnsConverter x:Key="ReportCardColumns"/>
  <local:ReportProfitToneConverter x:Key="ReportDifferenceTone"/>
  <Style x:Key="ReportMetricCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="17"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="MinHeight" Value="142"/></Style>
  <Style x:Key="ReportMetricTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#597164"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="ReportAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="ReportCell" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#294438"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
  <Style x:Key="ReportNumericCell" TargetType="TextBlock" BasedOn="{StaticResource ReportCell}"><Setter Property="TextAlignment" Value="Right"/></Style>
  <Style x:Key="ReportRowAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#187B52"/></Style>
  <Style x:Key="ReportHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="Background" Value="#F1F7F3"/><Setter Property="Foreground" Value="#365447"/><Setter Property="Padding" Value="9,0"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" TextWrapping="NoWrap"/><TextBlock Margin="5,0,0,0" TextWrapping="NoWrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="↕"/><Setter Property="Foreground" Value="#80968A"/><Style.Triggers><DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Ascending"><Setter Property="Text" Value="↑"/><Setter Property="Foreground" Value="#187B52"/></DataTrigger><DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Descending"><Setter Property="Text" Value="↓"/><Setter Property="Foreground" Value="#187B52"/></DataTrigger><DataTrigger Binding="{Binding Column.CanUserSort, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></Setter.Value></Setter>
  </Style>
  <ContextMenu x:Key="ReportRowMenu" x:Shared="False" Width="235" Style="{DynamicResource CashStatusMenuStyle}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
   <MenuItem Header="Ver detalhes" Click="ReportDetails_Click" Style="{DynamicResource CashMenuItemStyle}"><MenuItem.Icon><TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" Foreground="#187B52"/></MenuItem.Icon></MenuItem>
   <Separator/>
   <MenuItem Header="Histórico do produto" Click="ReportHistory_Click" Style="{DynamicResource CashMenuItemStyle}"><MenuItem.Icon><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="#187B52"/></MenuItem.Icon></MenuItem>
  </ContextMenu>
 </UserControl.Resources>
 <ScrollViewer x:Name="ReportsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" local:ControlledScrolling.IsEnabled="True" AutomationProperties.Name="Resultados do depósito" IsEnabled="{Binding IsAdmin}">
  <StackPanel Margin="0,0,5,8">
   <DockPanel Margin="0,0,0,18">
    <Button x:Name="ReportExportButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="ReportExport_Click" IsEnabled="{Binding ReportCanExport}" Padding="15,10" ToolTip="Exportar todos os produtos dos filtros aplicados, incluindo as outras páginas." AutomationProperties.Name="Exportar lucratividade"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,9,0"/><TextBlock Text="Exportar lucratividade" FontSize="13"/></StackPanel></Button>
    <ComboBox x:Name="ReportPeriodBox" ItemsSource="{Binding ReportPeriodOptions}" SelectedItem="{Binding ReportPeriod}" Width="240" Height="46" FontSize="13" HorizontalAlignment="Left" AutomationProperties.Name="Período dos resultados"/>
   </DockPanel>
   <UniformGrid x:Name="ReportSummaryCards" Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ReportCardColumns}}" Margin="0,0,-12,4">
    <Border Style="{StaticResource ReportMetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E4F5E9" CornerRadius="24" Width="48" Height="48" VerticalAlignment="Top"><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#187B52" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2"><TextBlock Text="RECEITA DOS PRODUTOS" Style="{StaticResource ReportMetricTitle}"/><Viewbox Height="34" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,8,0,5"><TextBlock x:Name="ReportRevenueValue" Text="{Binding ReportRevenue, StringFormat=C2}" FontSize="27" FontWeight="SemiBold" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="Receita líquida das vendas" FontSize="11" Foreground="#597164" TextWrapping="Wrap"/></StackPanel></Grid></Border>
    <Border Style="{StaticResource ReportMetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#FFF0D7" CornerRadius="24" Width="48" Height="48" VerticalAlignment="Top"><TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#A57226" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2"><TextBlock Text="CUSTO DOS PRODUTOS" Style="{StaticResource ReportMetricTitle}"/><Viewbox Height="34" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,8,0,5"><TextBlock x:Name="ReportCostValue" Text="{Binding ReportCost, StringFormat=C2}" FontSize="27" FontWeight="SemiBold" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="Custo no momento da venda" FontSize="11" Foreground="#597164" TextWrapping="Wrap"/></StackPanel></Grid></Border>
    <Border Style="{StaticResource ReportMetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E4F5E9" CornerRadius="24" Width="48" Height="48" VerticalAlignment="Top"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#187B52" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2"><TextBlock Text="LUCRO BRUTO" Style="{StaticResource ReportMetricTitle}"/><Viewbox Height="34" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,8,0,5"><TextBlock x:Name="ReportProfitValue" Text="{Binding ReportProfit, StringFormat=C2}" Foreground="{Binding ReportProfit, Converter={StaticResource ReportDifferenceTone}}" FontSize="27" FontWeight="SemiBold" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="Receita menos o custo" FontSize="11" Foreground="#597164" TextWrapping="Wrap"/></StackPanel></Grid></Border>
    <Border Style="{StaticResource ReportMetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E4F5E9" CornerRadius="24" Width="48" Height="48" VerticalAlignment="Top"><TextBlock Text="%" FontSize="26" FontWeight="SemiBold" Foreground="#187B52" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2"><TextBlock Text="MARGEM BRUTA" Style="{StaticResource ReportMetricTitle}"/><Viewbox Height="34" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,8,0,5"><TextBlock x:Name="ReportMarginValue" Text="{Binding ReportMargin}" FontSize="27" FontWeight="SemiBold" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="Lucro sobre a receita líquida" FontSize="11" Foreground="#597164" TextWrapping="Wrap"/></StackPanel></Grid></Border>
   </UniformGrid>
   <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Buscar produto" FontSize="12" Foreground="#365447" Margin="0,0,0,7"/><Border Background="White" BorderBrush="#D9E4DB" BorderThickness="1" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#365C49" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox x:Name="ReportSearchBox" Grid.Column="1" Style="{DynamicResource SearchTextBox}" Margin="0,0,12,0" Text="{Binding ReportSearch, UpdateSourceTrigger=PropertyChanged}" Tag="Nome ou código do produto..." MaxLength="180" FontSize="13" Height="44" AutomationProperties.Name="Buscar produto no relatório"/></Grid></Border></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Categoria" FontSize="12" Foreground="#365447" Margin="0,0,0,7"/><ComboBox x:Name="ReportCategoryBox" ItemsSource="{Binding ReportCategories}" SelectedItem="{Binding ReportCategory}" Height="44" FontSize="12" AutomationProperties.Name="Categoria do relatório"/></StackPanel>
    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="ReportApplyButton" Content="Aplicar" Click="ReportApply_Click" Style="{StaticResource PrimaryButton}" Height="44" Padding="16,10" Margin="0,0,9,0" AutomationProperties.Name="Aplicar filtros do relatório"/><Button x:Name="ReportClearButton" Content="Limpar" Click="ReportClear_Click" Style="{StaticResource ReportAction}" Height="44" AutomationProperties.Name="Limpar filtros do relatório"/></StackPanel>
   </Grid>
   <Border Style="{StaticResource Card}" Padding="0">
    <StackPanel><TextBlock Text="{Binding ReportAppliedHint}" Margin="16,12" FontSize="11" Foreground="#597164" TextWrapping="Wrap"/>
     <Grid Height="322">
      <DataGrid x:Name="ReportGrid" ItemsSource="{Binding ReportPageItems}" SelectedItem="{Binding SelectedReportRow}" RowHeight="68" ColumnHeaderHeight="42" ColumnHeaderStyle="{StaticResource ReportHeader}" Sorting="ReportGrid_Sorting" CanUserSortColumns="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" EnableRowVirtualization="True" EnableColumnVirtualization="True" local:ControlledScrolling.IsEnabled="True" AutomationProperties.Name="Lucratividade dos produtos">
       <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="9,0"/></Style></DataGrid.CellStyle>
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Produto" SortMemberPath="Name" Width="*" MinWidth="235"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid ToolTip="{Binding ProductHint}"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="46" Height="52" Background="#F2F7F3" CornerRadius="8" Padding="4"><Image Source="{Binding Image}" Stretch="Uniform"/></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Style="{StaticResource ReportCell}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" FontSize="11" Foreground="#6A8072" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantity, StringFormat=0.###}" SortMemberPath="Quantity" Width="112" ElementStyle="{StaticResource ReportNumericCell}"/>
        <DataGridTextColumn Header="Receita líquida" Binding="{Binding Revenue, StringFormat=C2}" SortMemberPath="Revenue" Width="142" ElementStyle="{StaticResource ReportNumericCell}"/>
        <DataGridTextColumn Header="Custo" Binding="{Binding Cost, StringFormat=C2}" SortMemberPath="Cost" Width="126" ElementStyle="{StaticResource ReportNumericCell}"/>
        <DataGridTemplateColumn Header="Lucro bruto" SortMemberPath="Profit" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Profit, StringFormat=C2}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Profit, Converter={StaticResource ReportDifferenceTone}}" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Profit, StringFormat=C2}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Margem" SortMemberPath="Margin" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Profit, Converter={StaticResource ReportDifferenceTone}, ConverterParameter=background}" CornerRadius="10" Padding="8,5" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding Margin, StringFormat=P1}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Profit, Converter={StaticResource ReportDifferenceTone}}" TextWrapping="NoWrap"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Ações" Width="91" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource ReportRowAction}" Click="ReportHistory_Click" ToolTip="Vendas deste produto no período" AutomationProperties.Name="Histórico deste produto"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button><Button x:Name="ReportMoreButton" Style="{StaticResource ReportRowAction}" ContextMenu="{StaticResource ReportRowMenu}" Click="ReportRowMenu_Click" Margin="5,0,0,0" ToolTip="Mais ações deste produto" AutomationProperties.Name="Mais ações do produto no relatório"><TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel x:Name="ReportEmptyState" Visibility="{Binding ReportEmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="20,40,20,0"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#B2CBB8" HorizontalAlignment="Center"/><TextBlock Text="Nenhum produto encontrado" FontSize="15" FontWeight="SemiBold" Foreground="#4B6856" Margin="0,12,0,5"/><TextBlock Text="Confira o período e os filtros. Apenas vendas concluídas entram nos resultados." FontSize="12" Foreground="#597164" TextAlignment="Center"/></StackPanel>
     </Grid>
     <Border Background="#F9FBF9" BorderBrush="#E1EAE3" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="16,12"><DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding ReportPageLabel}" FontSize="12" Foreground="#51695B" Margin="0,0,10,0" VerticalAlignment="Center"/><Button x:Name="ReportPreviousButton" Command="{Binding ReportPreviousPageCommand}" IsEnabled="{Binding ReportCanPrevious}" Content="‹" Width="34" Height="34" MinHeight="34" Padding="0" Margin="0,0,7,0" ToolTip="Página anterior"/><Button x:Name="ReportNextButton" Command="{Binding ReportNextPageCommand}" IsEnabled="{Binding ReportCanNext}" Content="›" Width="34" Height="34" MinHeight="34" Padding="0" ToolTip="Próxima página"/></StackPanel>
      <WrapPanel VerticalAlignment="Center"><TextBlock Text="{Binding ReportRangeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#365447" Margin="0,0,15,0" VerticalAlignment="Center"/><ComboBox x:Name="ReportPageSizeBox" ItemsSource="{Binding ReportPageSizeOptions}" SelectedItem="{Binding ReportPageSize}" Width="72" Height="34" MinHeight="34" Padding="8,6" FontSize="12" AutomationProperties.Name="Produtos por página no relatório"/><TextBlock Text="por página" FontSize="12" Foreground="#51695B" Margin="7,0,0,0" VerticalAlignment="Center"/></WrapPanel>
     </DockPanel></Border>
    </StackPanel>
   </Border>
   <Border Background="#F0F7F3" BorderBrush="#DFEBE2" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#187B52" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Descontos são distribuídos entre os produtos. O custo é registrado no momento da venda." FontSize="12" Foreground="#365447" TextWrapping="Wrap"/><TextBlock Text="Taxas de entrega e despesas operacionais não entram no lucro bruto dos produtos. Foto e categoria refletem o cadastro atual." FontSize="11" Foreground="#597164" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
