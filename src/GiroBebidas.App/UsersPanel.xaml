<UserControl x:Class="GiroBebidas.App.UsersPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GiroBebidas.App" Language="pt-BR">
 <UserControl.Resources>
  <Style x:Key="UserIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#187B52"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="UserCell" TargetType="TextBlock"><Setter Property="Foreground" Value="#294438"/><Setter Property="FontSize" Value="12"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="UserRowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE7E0"/></Style>
  <Style x:Key="UserMenuItem" TargetType="MenuItem"><Setter Property="Foreground" Value="#294438"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="ItemSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentPresenter ContentSource="Icon" VerticalAlignment="Center"/><ContentPresenter Grid.Column="2" ContentSource="Header" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E8F4ED"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="UserMenu" TargetType="ContextMenu"><Setter Property="Width" Value="240"/><Setter Property="Padding" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="White" BorderBrush="#DDE7E0" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}"><Border.Effect><DropShadowEffect Color="#112D25" BlurRadius="16" ShadowDepth="3" Opacity="0.15"/></Border.Effect><StackPanel IsItemsHost="True"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <ContextMenu x:Key="UserActions" x:Shared="False" Style="{StaticResource UserMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom" VerticalOffset="5">
   <ContextMenu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource UserMenuItem}"/></ContextMenu.Resources>
   <MenuItem Header="Ver detalhes" Click="Details_Click"><MenuItem.Icon><TextBlock Text="&#xE946;" Style="{StaticResource UserIcon}"/></MenuItem.Icon></MenuItem>
   <MenuItem Header="Editar usuário" Click="Edit_Click" IsEnabled="{Binding CanEdit}"><MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource UserIcon}"/></MenuItem.Icon></MenuItem>
   <MenuItem Header="Redefinir senha" Click="ResetPassword_Click" IsEnabled="{Binding CanEdit}"><MenuItem.Icon><TextBlock Text="&#xE8D7;" Style="{StaticResource UserIcon}"/></MenuItem.Icon></MenuItem>
   <MenuItem Header="Duplicar usuário" Click="Duplicate_Click" IsEnabled="{Binding CanEdit}"><MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource UserIcon}"/></MenuItem.Icon></MenuItem>
   <Separator Margin="6,4"/>
   <MenuItem Header="{Binding StateActionLabel}" Click="Active_Click" IsEnabled="{Binding CanChangeState}" ToolTip="{Binding StateActionHint}" ToolTipService.ShowOnDisabled="True"><MenuItem.Icon><TextBlock Text="&#xE8D8;" Style="{StaticResource UserIcon}"/></MenuItem.Icon></MenuItem>
  </ContextMenu>
 </UserControl.Resources>
 <ScrollViewer x:Name="UsersScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False" local:ControlledScrolling.IsEnabled="True" AutomationProperties.Name="Usuários e acessos">
  <StackPanel Margin="0,0,4,8">
   <UniformGrid Columns="4" Rows="1" Margin="0,0,-12,18">
    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="35" Height="35" Background="#E4F5E9" CornerRadius="18" VerticalAlignment="Center"><TextBlock Text="&#xE716;" Style="{StaticResource UserIcon}" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="TOTAL DE USUÁRIOS" Foreground="#597164" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="UserTotalMetric" Text="{Binding UserTotalCount}" FontSize="27" FontWeight="SemiBold" Foreground="#172B29" Margin="0,3,0,2"/><TextBlock Text="Usuários cadastrados" Foreground="#597164" FontSize="11" TextWrapping="Wrap"/></StackPanel></Grid></Border>
    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="35" Height="35" Background="#E4F5E9" CornerRadius="18" VerticalAlignment="Center"><TextBlock Text="&#xE73E;" Style="{StaticResource UserIcon}" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="ADMINISTRADORES" Foreground="#597164" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="UserAdminMetric" Text="{Binding UserAdminCount}" FontSize="27" FontWeight="SemiBold" Foreground="#172B29" Margin="0,3,0,2"/><TextBlock Text="Com acesso completo" Foreground="#597164" FontSize="11" TextWrapping="Wrap"/></StackPanel></Grid></Border>
    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="35" Height="35" Background="#E4F5E9" CornerRadius="18" VerticalAlignment="Center"><TextBlock Text="&#xE77B;" Style="{StaticResource UserIcon}" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="OPERADORES" Foreground="#597164" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="UserOperatorMetric" Text="{Binding UserOperatorCount}" FontSize="27" FontWeight="SemiBold" Foreground="#172B29" Margin="0,3,0,2"/><TextBlock Text="Com acesso de operação" Foreground="#597164" FontSize="11" TextWrapping="Wrap"/></StackPanel></Grid></Border>
    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="35" Height="35" Background="#E4F5E9" CornerRadius="18" VerticalAlignment="Center"><Ellipse Width="13" Height="13" Fill="#187B52" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="USUÁRIOS ATIVOS" Foreground="#597164" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="UserActiveMetric" Text="{Binding UserActiveCount}" FontSize="27" FontWeight="SemiBold" Foreground="#172B29" Margin="0,3,0,2"/><TextBlock Text="Ativos no sistema" Foreground="#597164" FontSize="11" TextWrapping="Wrap"/></StackPanel></Grid></Border>
   </UniformGrid>
   <WrapPanel Margin="0,0,-10,8">
    <Grid Width="330" Margin="0,0,10,10"><TextBox x:Name="UserSearchInput" Text="{Binding UserSearch, UpdateSourceTrigger=PropertyChanged}" Tag="Buscar por nome, usuário ou perfil..." Padding="39,10,12,10" Height="43" FontSize="12" AutomationProperties.Name="Buscar usuário"/><TextBlock Text="&#xE721;" Style="{StaticResource UserIcon}" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/></Grid>
    <ComboBox x:Name="UserRoleSelector" Width="150" Height="43" Margin="0,0,10,10" ItemsSource="{Binding UserRoleOptions}" SelectedItem="{Binding UserRoleFilter}" FontSize="12" AutomationProperties.Name="Filtrar por perfil"/>
    <ComboBox x:Name="UserStatusSelector" Width="157" Height="43" Margin="0,0,10,10" ItemsSource="{Binding UserStatusOptions}" SelectedItem="{Binding UserStatusFilter}" FontSize="12" AutomationProperties.Name="Filtrar por situação"/>
    <Button x:Name="UserEditSelectionButton" MinHeight="43" Padding="12,9" Margin="0,0,10,10" Click="Edit_Click" IsEnabled="{Binding UserCanEditSelection}" AutomationProperties.Name="Editar ou redefinir senha"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource UserIcon}" Margin="0,0,7,0"/><TextBlock Text="Editar / redefinir senha" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="UserCreateButton" MinHeight="43" Padding="14,9" Margin="0,0,0,10" Style="{StaticResource PrimaryButton}" Click="New_Click" IsEnabled="{Binding IsAdmin}" AutomationProperties.Name="Criar usuário"><StackPanel Orientation="Horizontal"><TextBlock Text="+" FontSize="21" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Criar usuário" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
   </WrapPanel>
   <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="344"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DataGrid x:Name="UsersGrid" ItemsSource="{Binding UserRows}" SelectedItem="{Binding SelectedUserRow, Mode=TwoWay}" RowHeight="65" ColumnHeaderHeight="43" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" local:ControlledScrolling.IsEnabled="True" EnableRowVirtualization="True" AutomationProperties.Name="Usuários cadastrados">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="Nome" Width="1.4*" MinWidth="165" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="#DDF3E4" Margin="0,0,11,0" VerticalAlignment="Center"><TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="SemiBold" Foreground="#187B52" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource UserCell}" FontWeight="SemiBold" ToolTip="{Binding Name}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Usuário" Binding="{Binding Username}" Width="*" MinWidth="105" ElementStyle="{StaticResource UserCell}"/>
       <DataGridTemplateColumn Header="Perfil" Width="154" SortMemberPath="RoleLabel"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="9" Padding="9,7" HorizontalAlignment="Left" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E6F0FC"/><Style.Triggers><DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Background" Value="#DFF5E6"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding RoleLabel}" FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#37648C"/><Style.Triggers><DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Foreground" Value="#187B52"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Situação" Width="99" SortMemberPath="Active"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="10" Padding="8,7" HorizontalAlignment="Left" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EFF2F3"/><Style.Triggers><DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Background" Value="#DFF5E6"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#677B87"/><Style.Triggers><DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Foreground" Value="#187B52"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Último acesso" Binding="{Binding LastLoginLabel}" Width="153" ElementStyle="{StaticResource UserCell}" SortMemberPath="LastLogin"/>
       <DataGridTemplateColumn Header="Ações" Width="101" CanUserSort="False"><DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="7,0"/></Style></DataGridTemplateColumn.CellStyle><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UserRowEditButton" Style="{StaticResource UserRowButton}" Click="Edit_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,6,0" ToolTip="Editar usuário" AutomationProperties.Name="Editar usuário"><TextBlock Text="&#xE70F;" Style="{StaticResource UserIcon}"/></Button><Button x:Name="UserRowMoreButton" Style="{StaticResource UserRowButton}" Click="More_Click" ContextMenu="{StaticResource UserActions}" ToolTip="Mais ações do usuário" AutomationProperties.Name="Mais ações do usuário"><TextBlock Text="&#xE712;" Style="{StaticResource UserIcon}"/></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <Border Background="White" Margin="0,44,0,0" Visibility="{Binding UserEmptyVisibility}" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#85A99A" HorizontalAlignment="Center" Margin="0,0,0,12"/><TextBlock Text="Nenhum usuário encontrado" FontSize="15" FontWeight="SemiBold" Foreground="#294438" HorizontalAlignment="Center"/><TextBlock Text="Ajuste a busca ou os filtros para consultar outras contas." FontSize="12" Foreground="#617B6E" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
     <Border Grid.Row="1" BorderBrush="#E4ECE7" BorderThickness="0,1,0,0" Padding="17,12"><TextBlock Text="{Binding UserCountLabel}" FontSize="12" Foreground="#496B59"/></Border>
    </Grid>
   </Border>
   <Border Background="#F0F7F3" BorderBrush="#E1EBE5" BorderThickness="1" CornerRadius="12" Padding="15,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="15" Background="#187B52" Margin="0,0,13,0" VerticalAlignment="Center"><TextBlock Text="i" FontSize="20" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" FontSize="12" Foreground="#355346" TextWrapping="Wrap" VerticalAlignment="Center"><Bold>Administrador:</Bold> acesso completo. <Bold>Operador:</Bold> vendas, pedidos, clientes, fiados e caixa. Senhas podem ser redefinidas pelo administrador; a senha atual nunca é exibida. Desativar preserva os registros anteriores.</TextBlock></Grid></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
