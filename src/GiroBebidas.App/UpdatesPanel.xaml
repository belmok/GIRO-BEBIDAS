<UserControl x:Class="GiroBebidas.App.UpdatesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Panel_Loaded">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MaxWidth="920" HorizontalAlignment="Left" Margin="0,0,10,8">
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Atualizações do Giro Bebidas" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="CurrentVersionLabel" Foreground="#187B52" FontWeight="SemiBold" Margin="0,8,0,16"/>
    <TextBlock Text="Receba novas versões publicadas no GitHub. A consulta pode ser automática; a instalação começa quando você escolher atualizar." TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
    <TextBlock Text="Repositório público" FontSize="12" Margin="0,22,0,6"/>
    <TextBox x:Name="RepositoryBox" MaxLength="220" TextChanged="Repository_Changed"/>
    <TextBlock Text="Aceita usuário/projeto ou o link do repositório no GitHub." FontSize="12" Foreground="#64776D" Margin="0,7,0,14"/>
    <CheckBox x:Name="AutoCheckBox" Content="Consultar atualizações ao entrar como administrador"/>
    <WrapPanel Margin="0,20,0,0">
     <Button x:Name="SaveButton" Content="Salvar configuração" Click="Save_Click" Margin="0,0,10,8"/>
     <Button x:Name="CheckButton" Content="Verificar atualizações" Style="{StaticResource PrimaryButton}" Click="Check_Click" Margin="0,0,10,8"/>
     <Button Content="Abrir publicações" Click="OpenReleases_Click" Margin="0,0,0,8"/>
    </WrapPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel>
    <TextBlock Text="Disponibilidade" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="StatusLabel" Text="Consulte as publicações para encontrar uma versão mais recente." TextWrapping="Wrap" Margin="0,12,0,12" Foreground="#36543D"/>
    <TextBlock x:Name="ReleaseLabel" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="NotesLabel" TextWrapping="Wrap" Foreground="#64776D" Margin="0,10,0,12"/>
    <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" Foreground="#187B52" Visibility="Collapsed" Margin="0,5,0,16"/>
    <WrapPanel>
     <Button x:Name="InstallButton" Content="Baixar e instalar atualização" Style="{StaticResource PrimaryButton}" Click="Install_Click" IsEnabled="False" Margin="0,0,10,8"/>
     <Button x:Name="CancelButton" Content="Cancelar download" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock Text="Antes de instalar, feche o caixa e finalize a venda atual. O sistema cria um backup, encerra o PDV e abre o instalador na pasta existente." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0"/>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
