<Window x:Class="GiroBebidas.App.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giro Bebidas • Confirmação" Width="580" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="pt-BR"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <Style x:Key="ConfirmationCloseStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#657C6E"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="CloseSurface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#E5F1E9"/><Setter Property="Foreground" Value="#187B52"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CloseSurface" Property="BorderBrush" Value="#187B52"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#D3E8DA"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Border Margin="12" Background="White" BorderBrush="#DCE8DF" BorderThickness="1" CornerRadius="17">
   <Border.Effect><DropShadowEffect Color="#112D25" BlurRadius="22" ShadowDepth="4" Opacity="0.18"/></Border.Effect>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#F6FAF7" BorderBrush="#E3ECE6" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0" Padding="25,22" MouseLeftButtonDown="Header_MouseLeftButtonDown">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
      <Border Width="48" Height="48" Background="#E1F2E6" CornerRadius="13" VerticalAlignment="Center">
       <Path Data="M 3,5 L 21,5 M 7,5 L 7,2 L 17,2 L 17,5 M 5,5 L 6,23 L 18,23 L 19,5 M 10,9 L 10,19 M 14,9 L 14,19" Width="24" Height="27" Stretch="Uniform" Stroke="#187B52" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
       <TextBlock x:Name="TitleLabel" x:FieldModifier="internal" FontSize="23" FontWeight="SemiBold" Foreground="#172B29" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="64" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       <TextBlock Text="GIRO BEBIDAS" FontSize="10" FontWeight="SemiBold" Foreground="#597465" Margin="0,5,0,0"/>
      </StackPanel>
      <Button x:Name="CloseButton" x:FieldModifier="internal" Grid.Column="3" Style="{StaticResource ConfirmationCloseStyle}" Click="Cancel_Click" VerticalAlignment="Top" ToolTip="Cancelar e fechar" AutomationProperties.Name="Cancelar e fechar confirmação">
       <Path Data="M 1,1 L 10,10 M 10,1 L 1,10" Width="11" Height="11" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Button>
     </Grid>
    </Border>
    <ScrollViewer x:Name="MessageScrollViewer" x:FieldModifier="internal" Grid.Row="1" Margin="27,23,27,0" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Mensagem da confirmação">
     <StackPanel>
      <TextBlock x:Name="MessageLabel" x:FieldModifier="internal" FontSize="14" Foreground="#51695B" TextWrapping="Wrap" LineHeight="22"/>
      <Border x:Name="NoticePanel" x:FieldModifier="internal" Background="#EAF6EE" BorderBrush="#D3EADB" BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,17,0,0">
       <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding NoticeText, RelativeSource={RelativeSource AncestorType=Window}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Path Data="M 11,1 C 8,3 4,3 1,3 L 1,11 C 1,16 6,20 11,22 C 16,20 21,16 21,11 L 21,3 C 18,3 14,3 11,1 Z M 6,11 L 10,15 L 16,8" Width="19" Height="22" Stretch="Uniform" Stroke="#187B52" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Top"/>
        <TextBlock x:Name="NoticeLabel" x:FieldModifier="internal" Grid.Column="2" Text="{Binding NoticeText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" FontWeight="SemiBold" Foreground="#365447" TextWrapping="Wrap" LineHeight="19"/>
       </Grid>
      </Border>
     </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="27,21,27,25">
     <Button x:Name="CancelButton" x:FieldModifier="internal" Content="Cancelar" Click="Cancel_Click" IsCancel="True" IsDefault="True" MinWidth="116" MinHeight="44" FontSize="13" Foreground="#365447" Margin="0,0,10,0" ToolTip="Cancelar e manter tudo como está." AutomationProperties.Name="Cancelar confirmação"/>
     <Button x:Name="ConfirmButton" x:FieldModifier="internal" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" IsDefault="False" MinWidth="148" MaxWidth="260" MinHeight="44" FontSize="13">
      <TextBlock x:Name="ConfirmLabel" x:FieldModifier="internal" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
     </Button>
    </WrapPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
