    <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Relatórios}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><Button Content="Exportar lucratividade" DockPanel.Dock="Right" Click="ExportProfit_Click"/><ComboBox Width="195" HorizontalAlignment="Left" SelectedItem="{Binding ReportPeriod}"><sys:String>Hoje</sys:String><sys:String>Últimos 7 dias</sys:String><sys:String>Últimos 30 dias</sys:String><sys:String>Todo o período</sys:String></ComboBox></DockPanel>
     <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-12,18"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="RECEITA DOS PRODUTOS" FontSize="10" Foreground="#819476"/><TextBlock Text="{Binding ReportRevenue, StringFormat=C2}" FontSize="27" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="CUSTO DOS PRODUTOS" FontSize="10" Foreground="#819476"/><TextBlock Text="{Binding ReportCost, StringFormat=C2}" FontSize="27" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="LUCRO BRUTO" FontSize="10" Foreground="#819476"/><TextBlock Text="{Binding ReportProfit, StringFormat=C2}" FontSize="27" FontWeight="SemiBold" Foreground="#24774C" Margin="0,13,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MARGEM BRUTA" FontSize="10" Foreground="#819476"/><TextBlock Text="{Binding ReportMargin}" FontSize="27" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel></Border></UniformGrid>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding ProfitRows}"><DataGrid.Columns><DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Quantidade" Binding="{Binding Quantity, StringFormat=0.###}" Width="115"/><DataGridTextColumn Header="Receita líquida" Binding="{Binding Revenue, StringFormat=C2}" Width="150"/><DataGridTextColumn Header="Custo" Binding="{Binding Cost, StringFormat=C2}" Width="145"/><DataGridTextColumn Header="Lucro bruto" Binding="{Binding Profit, StringFormat=C2}" Width="145"/><DataGridTextColumn Header="Margem" Binding="{Binding Margin, StringFormat=P1}" Width="105"/></DataGrid.Columns></DataGrid></Border><TextBlock Grid.Row="3" Text="Descontos são distribuídos entre os produtos. O custo é registrado no momento da venda. Taxas de entrega e despesas operacionais não entram no lucro bruto dos produtos." Foreground="#879780" FontSize="11" Margin="0,13,0,0"/>
    </Grid>
    <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Usuários}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Editar / redefinir senha" Click="EditUser_Click" Margin="0,0,10,0"/><Button Content="Criar usuário" Style="{StaticResource PrimaryButton}" Click="NewUser_Click"/></StackPanel><TextBlock Text="Cada pessoa, seu próprio acesso." VerticalAlignment="Center" Foreground="#7D8F74"/></DockPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"><DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Usuário" Binding="{Binding Username}" Width="200"/><DataGridTextColumn Header="Perfil" Binding="{Binding RoleLabel}" Width="170"/><DataGridTextColumn Header="Situação" Binding="{Binding StatusLabel}" Width="120"/><DataGridTextColumn Header="Último acesso" Binding="{Binding LastLogin, StringFormat=dd/MM/yyyy HH:mm}" Width="185"/></DataGrid.Columns></DataGrid></Border><Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0"><TextBlock Text="Administrador: acesso completo. Operador: vendas, pedidos, clientes, fiados e caixa. Senhas podem ser redefinidas pelo administrador; a senha atual não é exibida." Foreground="#7D8F74" FontSize="12"/></Border></Grid>
