   <MenuItem Header="{Binding ToggleActiveLabel}" Click="ToggleStockActive_Click" ToolTip="Alterar a disponibilidade deste produto para novas vendas."><MenuItem.Icon><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#187B52"/></MenuItem.Icon></MenuItem>
   <Separator><Separator.Style><Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#E6EEE8" Margin="9,5"/></ControlTemplate></Setter.Value></Setter></Style></Separator.Style></Separator>
   <MenuItem Header="Excluir produto" Click="DeleteStock_Click" Style="{StaticResource StockDangerMenuItemStyle}" IsEnabled="{Binding CanDelete}" ToolTip="{Binding DeleteHint}" ToolTipService.ShowOnDisabled="True"><MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#B4483E"/></MenuItem.Icon></MenuItem>
  </ContextMenu>
 </Window.Resources>
