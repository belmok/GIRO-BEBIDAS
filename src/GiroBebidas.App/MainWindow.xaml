     <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Impressoras do Windows" Click="WindowsPrinters_Click" Margin="0,0,8,0"/><Button Content="Editar" Click="EditPrinter_Click" Margin="0,0,8,0"/><Button Content="Remover" Click="DeletePrinter_Click" Margin="0,0,8,0"/><Button Content="Adicionar impressora" Style="{StaticResource PrimaryButton}" Click="NewPrinter_Click"/></StackPanel><TextBlock Text="Impressoras" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="1" Text="{Binding PrinterDefaultLabel, StringFormat=Padrão: {0}}" FontSize="11" Foreground="#8B9B80" Margin="0,10,0,15"/><DataGrid Grid.Row="2" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" RowHeight="42"><DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Impressora instalada" Binding="{Binding QueueName}" Width="2*"/><DataGridTextColumn Header="Papel" Binding="{Binding Paper}" Width="140"/></DataGrid.Columns></DataGrid></Grid></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Testar leitura" Click="TestScale_Click" Margin="0,0,8,0"/><Button Content="Editar" Click="EditScale_Click" Margin="0,0,8,0"/><Button Content="Remover" Click="DeleteScale_Click" Margin="0,0,8,0"/><Button Content="Adicionar balança" Style="{StaticResource PrimaryButton}" Click="NewScale_Click"/></StackPanel><TextBlock Text="Balanças" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="1" Text="{Binding ScaleDefaultLabel, StringFormat=Padrão: {0}}" FontSize="11" Foreground="#8B9B80" Margin="0,10,0,15"/><DataGrid Grid.Row="2" ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}" RowHeight="42"><DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Porta" Binding="{Binding Port}" Width="115"/><DataGridTextColumn Header="Velocidade" Binding="{Binding BaudRate}" Width="130"/><DataGridTextColumn Header="Protocolo" Binding="{Binding Protocol}" Width="220"/></DataGrid.Columns></DataGrid></Grid></Border>
