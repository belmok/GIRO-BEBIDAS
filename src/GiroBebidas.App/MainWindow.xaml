    <ScrollViewer Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Configurações}" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dados do depósito" Style="{StaticResource SectionTitle}"/><TextBlock Text="Essas informações aparecem nos cupons e pedidos." Style="{StaticResource MutedText}" Margin="0,0,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nome do depósito" Margin="0,0,0,6" FontSize="12"/><TextBox Text="{Binding Snapshot.Settings.Name}"/><TextBlock Text="Endereço" Margin="0,16,0,6" FontSize="12"/><TextBox Text="{Binding Snapshot.Settings.Address}"/><TextBlock Text="Mensagem no cupom" Margin="0,16,0,6" FontSize="12"/><TextBox Text="{Binding Snapshot.Settings.ReceiptFooter}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Telefone" Margin="0,0,0,6" FontSize="12"/><TextBox Text="{Binding Snapshot.Settings.Phone}"/><TextBlock Text="CNPJ / documento" Margin="0,16,0,6" FontSize="12"/><TextBox Text="{Binding Snapshot.Settings.Document}"/><CheckBox Content="Imprimir automaticamente ao concluir uma venda" IsChecked="{Binding Snapshot.Settings.AutoPrint}" Margin="0,22,0,8"/><CheckBox Content="Criar cópias de segurança automáticas diárias" IsChecked="{Binding Snapshot.Settings.DailyBackup}"/></StackPanel></Grid><Button Content="Salvar configurações" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,20,0,0" Click="SaveSettings_Click"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Backup e recuperação" Style="{StaticResource SectionTitle}"/><TextBlock Text="Guarde uma cópia em outro disco ou na nuvem. A restauração exige caixa fechado e faz uma cópia de proteção dos dados atuais." Foreground="#7D8F74" FontSize="12" Margin="0,0,0,18"/><StackPanel Orientation="Horizontal"><Button Content="Criar backup" Style="{StaticResource PrimaryButton}" Click="Backup_Click" Margin="0,0,10,0"/><Button Content="Restaurar backup" Click="Restore_Click" Margin="0,0,10,0"/><Button Content="Abrir pasta de dados" Click="DataFolder_Click"/></StackPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="220"/></Grid.RowDefinitions><TextBlock Text="Registro de operações" FontWeight="SemiBold"/><DataGrid Grid.Row="1" ItemsSource="{Binding AuditEntries}" RowHeight="32"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="170"/><DataGridTextColumn Header="Usuário" Binding="{Binding UserName}" Width="130"/><DataGridTextColumn Header="Operação" Binding="{Binding Action}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Border>
