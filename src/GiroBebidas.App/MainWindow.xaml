     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button Content="Imprimir fechamento" DockPanel.Dock="Right" Padding="12,5" MinHeight="28" Click="PrintCash_Click"/><TextBlock Text="Histórico de caixas" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding CashSessions}" SelectedItem="{Binding SelectedCash}" RowHeight="42"><DataGrid.Columns><DataGridTextColumn Header="Abertura" Binding="{Binding OpenedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Responsável" Binding="{Binding OpenedBy}" Width="*"/><DataGridTextColumn Header="Fundo" Binding="{Binding OpeningAmount, StringFormat=C2}" Width="110"/><DataGridTextColumn Header="Fechamento" Binding="{Binding ClosedAt, StringFormat=dd/MM HH:mm}" Width="135"/><DataGridTextColumn Header="Contado" Binding="{Binding CountedCash, StringFormat=C2}" Width="115"/><DataGridTextColumn Header="Diferença" Binding="{Binding Difference, StringFormat=C2}" Width="115"/><DataGridTextColumn Header="Situação" Binding="{Binding StatusLabel}" Width="100"/></DataGrid.Columns></DataGrid></Grid></Border><Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Suprimentos e sangrias" FontWeight="SemiBold"/><DataGrid Grid.Row="1" ItemsSource="{Binding CashMovements}" RowHeight="40"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Tipo" Binding="{Binding KindLabel}" Width="120"/><DataGridTextColumn Header="Valor" Binding="{Binding Amount, StringFormat=C2}" Width="120"/><DataGridText