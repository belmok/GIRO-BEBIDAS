     <Border Style="{StaticResource Card}" Margin="0,18,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="220"/></Grid.RowDefinitions><TextBlock Text="Registro de operações" FontWeight="SemiBold"/><DataGrid Grid.Row="1" ItemsSource="{Binding AuditEntries}" RowHeight="32"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="170"/><DataGridTextColumn Header="Usuário" Binding="{Binding UserName}" Width="130"/><DataGridTextColumn Header="Operação" Binding="{Binding Action}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Border>
    </StackPanel></ScrollViewer>
    <local:FiscalPanel x:Name="FiscalConfigurationPanel" Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Fiscal}"/>
    <local:UpdatesPanel x:Name="UpdatesConfigurationPanel" Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Atualizações}"/>
   </Grid>
   <Border x:Name="FooterStatusBar" Grid.Row="3" BorderBrush="#D6E3DA" BorderThickness="0,1,0,0" Padding="28,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="LocalDataIndicator" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Os dados são guardados neste computador.">
      <Ellipse Width="8" Height="8" Fill="#168A31" Margin="0,0,8,0" VerticalAlignment="Center"/>
      <TextBlock Text="DADOS LOCAIS" FontSize="11" FontWeight="SemiBold" Foreground="#365447" VerticalAlignment="Center"/>
      <TextBlock Text="•" FontSize="11" Foreground="#718C7C" Margin="10,0" VerticalAlignment="Center"/>
      <TextBlock Text="SALVAMENTO AUTOMÁTICO" FontSize="11" Foreground="#465F53" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel x:Name="FooterShortcuts" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
      <Border Background="#EDF3EF" BorderBrush="#D6E3DA" BorderThickness="1" CornerRadius="4" Padding="6,2"><TextBlock Text="F2" FontSize="11" FontWeight="Bold" Foreground="#187B52"/></Border>
      <TextBlock Text="Buscar produto" FontSize="11" Foreground="#465F53" Margin="6,0,16,0" VerticalAlignment="Center"/>
      <Border Background="#EDF3EF" BorderBrush="#D6E3DA" BorderThickness="1" CornerRadius="4" Padding="6,2"><TextBlock Text="F4" FontSize="11" FontWeight="Bold" Foreground="#187B52"/></Border>
      <TextBlock Text="Finalizar venda" FontSize="11" Foreground="#465F53" Margin="6,0,16,0" VerticalAlignment="Center"/>
      <Border Background="#EDF3EF" BorderBrush="#D6E3DA" BorderThickness="1" CornerRadius="4" Padding="6,2"><TextBlock Text="F5" FontSize="11" FontWeight="Bold" Foreground="#187B52"/></Border>
      <TextBlock Text="Atualizar" FontSize="11" Foreground="#465F53" Margin="6,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
