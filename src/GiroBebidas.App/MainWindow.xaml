   <ScrollViewer x:Name="MenuScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PreviewMouseWheel="MenuScroll_PreviewMouseWheel"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/></ScrollViewer.Resources><StackPanel><TextBlock Text="SEU DEPÓSITO" Foreground="#678D79" FontSize="10" Margin="13,0,0,14"/><ListBox x:Name="MenuNavigation" SelectionChanged="MenuNavigation_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" ItemsSource="{Binding Navigation}" SelectedValuePath="Key" SelectedValue="{Binding Page}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItemStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" FontSize="13"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></ScrollViewer>
