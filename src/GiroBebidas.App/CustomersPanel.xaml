<UserControl x:Class="GiroBebidas.App.CustomersPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GiroBebidas.App">
 <UserControl.Resources>
  <Style x:Key="CustomerAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="Padding" Value="12,8"/></Style>
  <Style x:Key="CustomerCell" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#294438"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Background="#EAF3DF" CornerRadius="25" Width="48" Height="48"><TextBlock Text="$" FontSize="27" FontWeight="SemiBold" Foreground="#187B52" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center"><TextBlock Text="Fiados a receber" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Total em aberto dos clientes" Foreground="#597164" FontSize="12" Margin="0,4,0,0"/></StackPanel>
   <Viewbox Grid.Column="2" MaxWidth="230" StretchDirection="DownOnly"><TextBlock x:Name="CustomerDebtValue" Text="{Binding TotalDebt, StringFormat=C2}" FontSize="27" FontWeight="SemiBold" Foreground="#97641E"/></Viewbox>
  </Grid></Border>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="#DCE7E0" BorderThickness="1" CornerRadius="10" Background="White"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#365C49" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBox x:Name="CustomerSearch" Grid.Column="1" Style="{DynamicResource SearchTextBox}" Tag="Buscar cliente por nome, telefone, documento ou endereço..." Margin="0,0,12,0" Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar clientes"/></Grid></Border>
   <DockPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="{Binding CustomerCountLabel}" Foreground="#597164" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left"/><WrapPanel HorizontalAlignment="Right">
    <Button x:Name="CustomerStatementButton" Content="Extrato de fiados" Style="{StaticResource CustomerAction}" IsEnabled="{Binding CustomerHasSelection}" Click="Statement_Click"/>
    <Button x:Name="CustomerReceiveButton" Content="Receber fiado" Style="{StaticResource CustomerAction}" IsEnabled="{Binding CustomerCanReceive}" Click="Receive_Click" ToolTip="Selecione um cliente com saldo devedor e mantenha o caixa aberto."/>
    <Button x:Name="CustomerEditButton" Content="Editar" Style="{StaticResource CustomerAction}" IsEnabled="{Binding CustomerHasSelection}" Click="Edit_Click"/>
    <Button x:Name="CustomerNewButton" Content="＋  Novo cliente" Style="{StaticResource PrimaryButton}" FontSize="12" MinHeight="40" Padding="14,8" Margin="0,0,0,6" Click="New_Click"/>
   </WrapPanel></DockPanel>
  </Grid></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid>
   <DataGrid x:Name="CustomersGrid" ItemsSource="{Binding CustomerRows}" SelectedItem="{Binding SelectedCustomer}" RowHeight="66" ColumnHeaderHeight="42" local:ControlledScrolling.IsEnabled="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Clientes e fiados" ColumnHeaderStyle="{DynamicResource SalesHeaderStyle}">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="Cliente" Width="1.5*" MinWidth="210" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" Background="#E1F0E6" CornerRadius="18" VerticalAlignment="Center"><TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="13" Foreground="#187B52" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource CustomerCell}" FontWeight="SemiBold" Margin="6,0,0,0"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" SortMemberPath="Phone" Width="125" ElementStyle="{StaticResource CustomerCell}"/>
     <DataGridTextColumn Header="Endereço" Binding="{Binding Address}" SortMemberPath="Address" Width="1.5*" MinWidth="165" ElementStyle="{StaticResource CustomerCell}"/>
     <DataGridTextColumn Header="Limite de fiado" Binding="{Binding Limit, StringFormat=C2}" SortMemberPath="Limit" Width="120" ElementStyle="{StaticResource CustomerCell}"/>
     <DataGridTextColumn Header="Saldo devedor" Binding="{Binding Balance, StringFormat=C2}" SortMemberPath="Balance" Width="120" ElementStyle="{StaticResource CustomerCell}"/>
     <DataGridTemplateColumn Header="Situação" SortMemberPath="Status" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StatusBackground}" CornerRadius="10" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Fill="{Binding StatusForeground}" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusForeground}"/></StackPanel></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Ações" CanUserSort="False" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{DynamicResource StockRowActionStyle}" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" ToolTip="Editar cliente" Click="Edit_Click"/>
      <Button x:Name="CustomerRowMenuButton" Style="{DynamicResource StockRowActionStyle}" Content="⋮" FontSize="20" ToolTip="Ações do cliente" Click="Menu_Click"><Button.ContextMenu><ContextMenu Style="{DynamicResource CashStatusMenuStyle}" Width="230">
       <MenuItem Header="Ver detalhes" Click="Details_Click" Style="{DynamicResource CashMenuItemStyle}"/>
       <MenuItem Header="Extrato do cliente" Click="Statement_Click" Style="{DynamicResource CashMenuItemStyle}"/>
       <MenuItem Header="Registrar recebimento" Click="Receive_Click" Style="{DynamicResource CashMenuItemStyle}"/>
       <MenuItem Header="Editar cliente" Click="Edit_Click" Style="{DynamicResource CashMenuItemStyle}"/>
       <Separator/><MenuItem Header="Duplicar cliente" Click="Duplicate_Click" Style="{DynamicResource CashMenuItemStyle}"/>
       <MenuItem Header="{Binding CreditActionLabel}" Click="Credit_Click" Style="{DynamicResource CashMenuItemStyle}"/>
       <MenuItem Header="Excluir cliente" Click="Delete_Click" IsEnabled="{Binding CanDelete}" ToolTip="Exclusão permitida ao administrador para clientes sem vendas nem pedidos." Foreground="#B83B30" Style="{DynamicResource CashMenuItemStyle}"/>
      </ContextMenu></Button.ContextMenu></Button>
     </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <StackPanel Visibility="{Binding CustomerEmptyVisibility}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#8CAB98" HorizontalAlignment="Center"/><TextBlock Text="Nenhum cliente encontrado" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Confira a busca ou cadastre um novo cliente." FontSize="12" Foreground="#597164" Margin="0,6,0,0"/></StackPanel>
  </Grid></Border>
  <Border Grid.Row="3" Background="#F3F8F4" BorderBrush="#DFEAE2" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0"><TextBlock Foreground="#526D5C" FontSize="12" TextWrapping="Wrap" Text="O recebimento exige caixa aberto. Bloquear fiado impede novas vendas a prazo e mantém disponíveis os recebimentos e o histórico do cliente."/></Border>
 </Grid>
</UserControl>
