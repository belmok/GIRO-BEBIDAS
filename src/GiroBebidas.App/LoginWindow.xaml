<Window x:Class="GiroBebidas.App.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Giro Bebidas • Entrar" Width="1000" Height="650" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="White">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="480"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#112D28"><Grid Margin="45,44">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal"><Image x:Name="LoginBrandLogo" Source="/Assets/giro-bebidas-icon-v1.png" Width="46" Height="46" Stretch="Uniform" AutomationProperties.Name="Logo Giro Bebidas com garrafa"/><StackPanel Margin="10,1,0,0"><TextBlock Text="GIRO" FontSize="23" FontWeight="Bold" Foreground="White"/><TextBlock Text="B E B I D A S" FontSize="10" Foreground="#A5C2B5"/></StackPanel></StackPanel>
   <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="Seu depósito.&#10;Tudo no seu ritmo." FontSize="37" FontWeight="SemiBold" Foreground="#F1F9F1" LineHeight="48"/><TextBlock Text="Do primeiro atendimento ao fechamento do caixa, cuide do seu negócio em um só lugar." Foreground="#AFC8BD" FontSize="16" LineHeight="25" Margin="0,20,0,0"/>
    <Border Background="#1C3F33" CornerRadius="18" Padding="23" Margin="0,35,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#B9EAB6" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="Mais controle. Mais tranquilidade." Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Vendas · Estoque · Clientes · Entregas" Foreground="#ABC7B6" FontSize="12" Margin="0,7,0,0"/></StackPanel></Grid></Border>
   </StackPanel><TextBlock Grid.Row="2" Text="FEITO PARA QUEM MOVIMENTA O DIA." FontSize="10" Foreground="#88AB99"/>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="62,45"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Center">
   <TextBlock Text="Bem-vindo de volta" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Entre para começar o atendimento." Foreground="#778681" FontSize="14" Margin="0,10,0,32"/>
   <TextBlock Text="Usuário" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="UsernameInput" Text="ADMIN" FontSize="15" MaxLength="30" KeyDown="Input_KeyDown"/>
   <TextBlock Text="Senha" FontWeight="SemiBold" Margin="0,22,0,8"/><PasswordBox x:Name="PasswordInput" FontSize="15" MaxLength="128" KeyDown="Input_KeyDown"/>
   <TextBlock x:Name="ErrorText" Foreground="#B4483B" MinHeight="40" FontSize="12" Margin="0,10,0,4"/>
   <Button x:Name="LoginButton" Content="Entrar no sistema   →" Style="{StaticResource PrimaryButton}" Height="48" Click="Login_Click" IsDefault="True"/>
   <TextBlock Text="Seu acesso é individual. As operações ficam registradas no seu usuário." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,22,0,0" LineHeight="19"/>
  </StackPanel><TextBlock Grid.Row="1" Text="GIRO BEBIDAS  /  PDV PARA WINDOWS" Foreground="#99A69F" FontSize="10" HorizontalAlignment="Center"/></Grid>
 </Grid>
</Window>
