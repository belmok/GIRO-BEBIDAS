<UserControl x:Class="GiroBebidas.App.FiscalPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="FiscalCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="18"/><Setter Property="CornerRadius" Value="14"/></Style>
  <Style x:Key="FiscalIconBadge" TargetType="Border"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="#E5F4EB"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  <Style x:Key="FiscalSectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#1E382B"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="FiscalDescription" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#617B6E"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="FiscalValue" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#294438"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,10,0,0"/></Style>
  <Style x:Key="FiscalIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="22"/><Setter Property="Foreground" Value="#187B52"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="FiscalAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#187B52"/></Style>
  <Style x:Key="FiscalPrimaryAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="13,8"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="FiscalRemoveAction" TargetType="Button" BasedOn="{StaticResource DangerButton}"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/></Style>
 </UserControl.Resources>
 <StackPanel IsEnabled="{Binding IsAdmin}" AutomationProperties.Name="Configuração fiscal e NFC-e">
  <Border x:Name="FiscalIntegrationNotice" Background="#FFF8EB" BorderBrush="#F0E2BE" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#A67526" Margin="0,0,12,0" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1"><TextBlock Text="Emissor SEFAZ pendente de integração" FontSize="13" FontWeight="SemiBold" Foreground="#88641E"/><TextBlock Text="Você pode cadastrar os dados e conferir as pendências. As vendas desta versão geram comprovantes não fiscais; a autorização de NFC-e e a impressão do DANFE dependem da integração do emissor." FontSize="12" Foreground="#886F3A" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="FiscalIssuerCard" Style="{StaticResource FiscalCard}">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xE80F;" Style="{StaticResource FiscalIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Empresa emitente" Style="{StaticResource FiscalSectionTitle}"/><TextBlock Text="CNPJ, inscrição estadual, regime e endereço." Style="{StaticResource FiscalDescription}" Margin="0,4,0,0"/></StackPanel></Grid>
     <TextBlock Text="{Binding FiscalIssuerLabel}" Style="{StaticResource FiscalValue}"/>
     <Button x:Name="FiscalIssuerButton" Content="Dados da empresa" Click="Issuer_Click" Style="{StaticResource FiscalAction}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Dados fiscais da empresa"/>
    </StackPanel>
   </Border>
   <Border x:Name="FiscalOptionsCard" Grid.Column="2" Style="{StaticResource FiscalCard}">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xE713;" Style="{StaticResource FiscalIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Ambiente e numeração" Style="{StaticResource FiscalSectionTitle}"/><TextBlock Text="NFC-e • modelo 65" Style="{StaticResource FiscalDescription}" Margin="0,4,0,0"/></StackPanel></Grid>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E5F4EB" CornerRadius="8" Padding="8,4" VerticalAlignment="Top"><TextBlock Text="{Binding FiscalEnvironmentLabel}" FontSize="12" Foreground="#187B52" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="1" Text="{Binding FiscalNumberLabel}" Style="{StaticResource FiscalDescription}" Margin="10,3,0,0" VerticalAlignment="Center"/></Grid>
     <Button x:Name="FiscalOptionsButton" Content="Configurar NFC-e" Click="Options_Click" Style="{StaticResource FiscalAction}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Configurar NFC-e"/>
    </StackPanel>
   </Border>
   <Border x:Name="FiscalCertificateCard" Grid.Row="2" Style="{StaticResource FiscalCard}">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xEB95;" Style="{StaticResource FiscalIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Certificado digital A1" Style="{StaticResource FiscalSectionTitle}"/><TextBlock Text="Protegido para seu usuário do Windows." Style="{StaticResource FiscalDescription}" Margin="0,4,0,0"/></StackPanel></Grid>
     <TextBlock Text="{Binding FiscalCertificateLabel}" Style="{StaticResource FiscalValue}"/>
     <WrapPanel Margin="0,10,-8,-4"><Button x:Name="FiscalCertificateButton" Content="Importar A1" Click="Certificate_Click" Style="{StaticResource FiscalAction}" Margin="0,0,8,4" AutomationProperties.Name="Importar certificado A1"/><Button Content="Remover" Click="RemoveCertificate_Click" Style="{StaticResource FiscalRemoveAction}" Margin="0,0,8,4" AutomationProperties.Name="Remover certificado A1"/></WrapPanel>
    </StackPanel>
   </Border>
   <Border x:Name="FiscalCscCard" Grid.Row="2" Grid.Column="2" Style="{StaticResource FiscalCard}">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xE72E;" Style="{StaticResource FiscalIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Código de segurança • CSC" Style="{StaticResource FiscalSectionTitle}"/><TextBlock Text="Códigos separados por ambiente." Style="{StaticResource FiscalDescription}" Margin="0,4,0,0"/></StackPanel></Grid>
     <TextBlock Text="{Binding FiscalCscLabel}" Style="{StaticResource FiscalValue}"/>
     <WrapPanel Margin="0,10,-8,-4"><Button x:Name="FiscalCscButton" Content="Cadastrar / trocar CSC" Click="Csc_Click" Style="{StaticResource FiscalAction}" Margin="0,0,8,4" AutomationProperties.Name="Cadastrar ou trocar CSC"/><Button Content="Remover" Click="RemoveCsc_Click" Style="{StaticResource FiscalRemoveAction}" Margin="0,0,8,4" AutomationProperties.Name="Remover CSC"/></WrapPanel>
    </StackPanel>
   </Border>
   <Border x:Name="FiscalPrinterCard" Grid.Row="4" Style="{StaticResource FiscalCard}">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xE749;" Style="{StaticResource FiscalIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Impressora fiscal" Style="{StaticResource FiscalSectionTitle}"/><TextBlock Text="Impressora reservada para o documento fiscal." Style="{StaticResource FiscalDescription}" Margin="0,4,0,0"/></StackPanel></Grid>
     <TextBlock Text="{Binding FiscalPrinterLabel}" Style="{StaticResource FiscalValue}"/>
     <WrapPanel Margin="0,10,-8,-4">
      <Button x:Name="FiscalPrinterButton" Content="Configurar impressora" Click="Printer_Click" Style="{StaticResource FiscalPrimaryAction}" Margin="0,0,8,4" AutomationProperties.Name="Configurar impressora fiscal"/>
      <Button x:Name="FiscalEquipmentButton" Content="Cadastrar em Equipamentos" Click="Equipment_Click" Style="{StaticResource FiscalAction}" Margin="0,0,8,4" AutomationProperties.Name="Cadastrar impressora em Equipamentos"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <Border x:Name="FiscalProductsCard" Grid.Row="4" Grid.Column="2" Style="{StaticResource FiscalCard}">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xE8A5;" Style="{StaticResource FiscalIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Natureza da operação e tributos" Style="{StaticResource FiscalSectionTitle}"/><TextBlock Text="CFOP e tributação no cadastro de cada produto." Style="{StaticResource FiscalDescription}" Margin="0,4,0,0"/></StackPanel></Grid>
     <TextBlock Text="Revise NCM, CEST, CFOP, CST/CSOSN e origem." Style="{StaticResource FiscalValue}"/>
     <Button x:Name="FiscalProductsButton" Content="Revisar produtos" Click="Products_Click" Style="{StaticResource FiscalAction}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Revisar dados fiscais dos produtos"/>
    </StackPanel>
   </Border>
  </Grid>
  <Border x:Name="ChecksCard" Style="{StaticResource FiscalCard}" Margin="0,16,0,0">
   <StackPanel>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xE9D5;" Style="{StaticResource FiscalIcon}"/></Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="Conferência da configuração" Style="{StaticResource FiscalSectionTitle}"/><TextBlock Text="Esta conferência verifica campos locais. Não consulta cadastro, credenciamento ou autorização na SEFAZ." Style="{StaticResource FiscalDescription}" Margin="0,4,0,0"/></StackPanel>
     <Button x:Name="FiscalCheckButton" Grid.Column="2" Click="Check_Click" Style="{StaticResource FiscalAction}" VerticalAlignment="Center" AutomationProperties.Name="Atualizar conferência fiscal"><TextBlock Text="Atualizar conferência" TextWrapping="Wrap" TextAlignment="Center"/></Button>
    </Grid>
    <Border BorderBrush="#E3EBE6" BorderThickness="1" CornerRadius="10" Padding="10,0">
     <StackPanel>
      <Border Background="#F0F7F3" CornerRadius="9,9,0,0" Padding="10,12" Margin="-10,0,-10,0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Item" FontSize="12" FontWeight="SemiBold" Foreground="#496658"/><TextBlock Grid.Column="1" Text="Status" FontSize="12" FontWeight="SemiBold" Foreground="#496658"/><TextBlock Grid.Column="2" Text="Descrição" FontSize="12" FontWeight="SemiBold" Foreground="#496658"/></Grid>
      </Border>
      <ItemsControl x:Name="FiscalChecksList" ItemsSource="{Binding FiscalChecks}" AutomationProperties.Name="Pendências da configuração fiscal">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="#E8EEE9" BorderThickness="0,0,0,1" Padding="0,10" MinHeight="52">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Item}" FontWeight="SemiBold" FontSize="12" Foreground="#294438" TextWrapping="Wrap" Margin="3,0,12,0" VerticalAlignment="Center"/>
          <Border Grid.Column="1" CornerRadius="8" Padding="8,6" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center">
           <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFF3DD"/><Style.Triggers><DataTrigger Binding="{Binding Complete}" Value="True"><Setter Property="Background" Value="#E4F5EB"/></DataTrigger></Style.Triggers></Style></Border.Style>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE7BA;"/><Setter Property="Foreground" Value="#B47718"/><Style.Triggers><DataTrigger Binding="{Binding Complete}" Value="True"><Setter Property="Text" Value="&#xE73E;"/><Setter Property="Foreground" Value="#187B52"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#965F12"/><Style.Triggers><DataTrigger Binding="{Binding Complete}" Value="True"><Setter Property="Foreground" Value="#187B52"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
           </Grid>
          </Border>
          <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="#617B6E" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,2,0"/>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
