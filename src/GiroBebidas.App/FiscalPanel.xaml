<UserControl x:Class="GiroBebidas.App.FiscalPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,0,8,12">
   <Border Background="#FFF6E5" BorderBrush="#ECDDAD" BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,0,0,18">
    <StackPanel><TextBlock Text="CONFIGURAÇÃO FISCAL" FontSize="10" FontWeight="SemiBold" Foreground="#92722D"/><TextBlock Text="Emissor SEFAZ pendente de integração" FontSize="18" FontWeight="SemiBold" Foreground="#78591C" Margin="0,7,0,6"/><TextBlock Text="Você pode cadastrar os dados e conferir as pendências. As vendas desta versão geram comprovantes não fiscais; a autorização de NFC-e e a impressão do DANFE dependem da integração do emissor." FontSize="12" Foreground="#8C753F" TextWrapping="Wrap"/></StackPanel>
   </Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01  EMPRESA EMITENTE" FontSize="10" Foreground="#71866D" FontWeight="SemiBold"/><TextBlock Text="{Binding FiscalIssuerLabel}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,5"/><TextBlock Text="CNPJ, inscrição estadual, regime tributário e endereço." Style="{StaticResource MutedText}" TextWrapping="Wrap"/><Button Content="Dados da empresa" Click="Issuer_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="02  NFC-e • MODELO 65" FontSize="10" Foreground="#71866D" FontWeight="SemiBold"/><TextBlock Text="{Binding FiscalEnvironmentLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="{Binding FiscalNumberLabel}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/><Button Content="Configurar NFC-e" Click="Options_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
   </Grid>
   <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="03  CERTIFICADO DIGITAL A1" FontSize="10" Foreground="#71866D" FontWeight="SemiBold"/><TextBlock Text="{Binding FiscalCertificateLabel}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,5"/><TextBlock Text="Arquivo e senha protegidos para seu usuário do Windows." Style="{StaticResource MutedText}" TextWrapping="Wrap"/><WrapPanel Margin="0,18,0,0"><Button Content="Importar A1" Click="Certificate_Click" Margin="0,0,10,6"/><Button Content="Remover" Click="RemoveCertificate_Click" Margin="0,0,0,6"/></WrapPanel></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="04  CÓDIGO DE SEGURANÇA • CSC" FontSize="10" Foreground="#71866D" FontWeight="SemiBold"/><TextBlock Text="{Binding FiscalCscLabel}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,5"/><TextBlock Text="Homologação e produção mantêm códigos separados." Style="{StaticResource MutedText}" TextWrapping="Wrap"/><WrapPanel Margin="0,18,0,0"><Button Content="Cadastrar / trocar CSC" Click="Csc_Click" Margin="0,0,10,6"/><Button Content="Remover" Click="RemoveCsc_Click" Margin="0,0,0,6"/></WrapPanel></StackPanel></Border>
   </Grid>
   <Border Style="{StaticResource Card}" Margin="0,18,0,0"><DockPanel><Button Content="Conferir configuração" Click="Check_Click" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Impressora para o documento fiscal" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding FiscalPrinterLabel}" Style="{StaticResource MutedText}" Margin="0,6,18,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
   <Border x:Name="ChecksCard" Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Conferência da configuração" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Esta conferência verifica campos locais. Não consulta cadastro, credenciamento ou autorização na SEFAZ." Style="{StaticResource MutedText}" Margin="0,7,0,15" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding FiscalChecks}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E8EEE5" BorderThickness="0,1,0,0" Padding="0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Item}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Margin="0,0,12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A1772F"/><Style.Triggers><DataTrigger Binding="{Binding Complete}" Value="True"><Setter Property="Foreground" Value="#277747"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Foreground="#71866D" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
