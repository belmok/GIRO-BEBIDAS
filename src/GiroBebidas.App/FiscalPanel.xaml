<UserControl x:Class="GiroBebidas.App.FiscalPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="FiscalCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="22"/><Setter Property="CornerRadius" Value="15"/></Style>
  <Style x:Key="FiscalIconBadge" TargetType="Border"><Setter Property="Width" Value="54"/><Setter Property="Height" Value="54"/><Setter Property="CornerRadius" Value="27"/><Setter Property="Background" Value="#E5F4EB"/><Setter Property="Margin" Value="0,0,16,0"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
  <Style x:Key="FiscalSectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#1E382B"/></Style>
  <Style x:Key="FiscalDescription" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#617B6E"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="FiscalIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="25"/><Setter Property="Foreground" Value="#187B52"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </UserControl.Resources>
 <StackPanel Margin="0,18,0,0" IsEnabled="{Binding IsAdmin}" AutomationProperties.Name="Configuração fiscal e NFC-e">
  <Border x:Name="FiscalHeaderCard" Style="{StaticResource FiscalCard}" Background="#F7FBF8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource FiscalIconBadge}" CornerRadius="13"><Path Data="M 3,1 L 17,1 L 25,9 L 25,31 L 3,31 Z M 17,1 L 17,9 L 25,9 M 8,16 L 20,16 M 8,21 L 20,21 M 8,26 L 16,26" Width="27" Height="31" Stretch="Uniform" Stroke="#187B52" StrokeThickness="2" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Cupom fiscal e NFC-e" FontSize="25" FontWeight="SemiBold" Foreground="#1E382B"/><TextBlock Text="Prepare os dados fiscais e acompanhe o que falta configurar." Style="{StaticResource FiscalDescription}" Margin="0,5,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Border x:Name="FiscalPrinterCard" Style="{StaticResource FiscalCard}" Margin="0,18,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xE749;" Style="{StaticResource FiscalIcon}"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="Impressora para o documento fiscal" Style="{StaticResource FiscalSectionTitle}"/><TextBlock Text="{Binding FiscalPrinterLabel}" Style="{StaticResource FiscalDescription}" Margin="0,6,0,0"/></StackPanel>
    <Button x:Name="FiscalCheckButton" Grid.Column="2" Click="Check_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" MinHeight="46" Padding="18,12" AutomationProperties.Name="Conferir configuração fiscal">
     <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="19" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Conferir configuração" FontSize="14" VerticalAlignment="Center"/><TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
    </Button>
   </Grid>
  </Border>
  <Border x:Name="ChecksCard" Style="{StaticResource FiscalCard}" Margin="0,18,0,0">
   <StackPanel>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource FiscalIconBadge}"><Path Data="M 3,1 L 17,1 L 24,8 L 24,28 L 3,28 Z M 17,1 L 17,8 L 24,8 M 8,14 L 19,14 M 8,19 L 19,19 M 8,24 L 15,24" Width="25" Height="28" Stretch="Uniform" Stroke="#187B52" StrokeThickness="2" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Conferência da configuração" Style="{StaticResource FiscalSectionTitle}"/><TextBlock Text="Esta conferência verifica campos locais. Não consulta cadastro, credenciamento ou autorização na SEFAZ." Style="{StaticResource FiscalDescription}" Margin="0,6,0,0"/></StackPanel>
    </Grid>
    <Border BorderBrush="#E3EBE6" BorderThickness="1" CornerRadius="12" Padding="12,0">
     <StackPanel>
      <Border Background="#F0F7F3" CornerRadius="11,11,0,0" Padding="12,14" Margin="-12,0,-12,0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Item" FontSize="13" FontWeight="SemiBold" Foreground="#496658"/><TextBlock Grid.Column="1" Text="Status" FontSize="13" FontWeight="SemiBold" Foreground="#496658"/><TextBlock Grid.Column="2" Text="Descrição" FontSize="13" FontWeight="SemiBold" Foreground="#496658"/></Grid>
      </Border>
      <ItemsControl x:Name="FiscalChecksList" ItemsSource="{Binding FiscalChecks}" AutomationProperties.Name="Pendências da configuração fiscal">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="#E8EEE9" BorderThickness="0,0,0,1" Padding="0,14" MinHeight="66">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Item}" FontWeight="SemiBold" FontSize="13" Foreground="#294438" TextWrapping="Wrap" Margin="3,0,14,0" VerticalAlignment="Center"/>
          <Border Grid.Column="1" CornerRadius="10" Padding="10,7" Margin="0,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
           <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFF3DD"/><Style.Triggers><DataTrigger Binding="{Binding Complete}" Value="True"><Setter Property="Background" Value="#E4F5EB"/></DataTrigger></Style.Triggers></Style></Border.Style>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,7,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE7BA;"/><Setter Property="Foreground" Value="#B47718"/><Style.Triggers><DataTrigger Binding="{Binding Complete}" Value="True"><Setter Property="Text" Value="&#xE73E;"/><Setter Property="Foreground" Value="#187B52"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#965F12"/><Style.Triggers><DataTrigger Binding="{Binding Complete}" Value="True"><Setter Property="Foreground" Value="#187B52"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
           </Grid>
          </Border>
          <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="13" Foreground="#617B6E" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,2,0"/>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>
   </StackPanel>
  </Border>
  <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="FiscalIssuerCard" Style="{StaticResource FiscalCard}"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xE80F;" Style="{StaticResource FiscalIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Empresa emitente" FontSize="19" FontWeight="SemiBold" Foreground="#1E382B"/><TextBlock Text="CNPJ, inscrição estadual, regime e endereço." Style="{StaticResource FiscalDescription}" Margin="0,5,0,0"/></StackPanel></Grid>
    <TextBlock Text="{Binding FiscalIssuerLabel}" FontSize="15" FontWeight="SemiBold" Foreground="#294438" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <Button x:Name="FiscalIssuerButton" Content="Dados da empresa" Click="Issuer_Click" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.Name="Dados fiscais da empresa"/>
   </StackPanel></Border>
   <Border x:Name="FiscalOptionsCard" Grid.Column="2" Style="{StaticResource FiscalCard}"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xE713;" Style="{StaticResource FiscalIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="NFC-e • modelo 65" FontSize="19" FontWeight="SemiBold" Foreground="#1E382B"/><TextBlock Text="Ambiente, série, numeração e impressora." Style="{StaticResource FiscalDescription}" Margin="0,5,0,0"/></StackPanel></Grid>
    <TextBlock Text="{Binding FiscalEnvironmentLabel}" FontSize="15" FontWeight="SemiBold" Foreground="#294438" TextWrapping="Wrap" Margin="0,16,0,5"/><TextBlock Text="{Binding FiscalNumberLabel}" Style="{StaticResource FiscalDescription}"/>
    <Button x:Name="FiscalOptionsButton" Content="Configurar NFC-e" Click="Options_Click" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.Name="Configurar NFC-e"/>
   </StackPanel></Border>
  </Grid>
  <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="FiscalCertificateCard" Style="{StaticResource FiscalCard}"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xEB95;" Style="{StaticResource FiscalIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Certificado digital A1" FontSize="19" FontWeight="SemiBold" Foreground="#1E382B"/><TextBlock Text="Protegido para seu usuário do Windows." Style="{StaticResource FiscalDescription}" Margin="0,5,0,0"/></StackPanel></Grid>
    <TextBlock Text="{Binding FiscalCertificateLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#294438" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <WrapPanel Margin="0,16,-10,-6"><Button x:Name="FiscalCertificateButton" Content="Importar A1" Click="Certificate_Click" Margin="0,0,10,6" AutomationProperties.Name="Importar certificado A1"/><Button Content="Remover" Click="RemoveCertificate_Click" Style="{StaticResource DangerButton}" Margin="0,0,10,6" AutomationProperties.Name="Remover certificado A1"/></WrapPanel>
   </StackPanel></Border>
   <Border x:Name="FiscalCscCard" Grid.Column="2" Style="{StaticResource FiscalCard}"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FiscalIconBadge}"><TextBlock Text="&#xE72E;" Style="{StaticResource FiscalIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Código de segurança • CSC" FontSize="19" FontWeight="SemiBold" Foreground="#1E382B"/><TextBlock Text="Homologação e produção mantêm códigos separados." Style="{StaticResource FiscalDescription}" Margin="0,5,0,0"/></StackPanel></Grid>
    <TextBlock Text="{Binding FiscalCscLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#294438" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <WrapPanel Margin="0,16,-10,-6"><Button x:Name="FiscalCscButton" Content="Cadastrar / trocar CSC" Click="Csc_Click" Margin="0,0,10,6" AutomationProperties.Name="Cadastrar ou trocar CSC"/><Button Content="Remover" Click="RemoveCsc_Click" Style="{StaticResource DangerButton}" Margin="0,0,10,6" AutomationProperties.Name="Remover CSC"/></WrapPanel>
   </StackPanel></Border>
  </Grid>
  <Border Background="#FFF8EB" BorderBrush="#F0E2BE" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,18,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#A67526" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Emissor SEFAZ pendente de integração" FontSize="14" FontWeight="SemiBold" Foreground="#88641E"/><TextBlock Text="Você pode cadastrar os dados e conferir as pendências. As vendas desta versão geram comprovantes não fiscais; a autorização de NFC-e e a impressão do DANFE dependem da integração do emissor." FontSize="12" Foreground="#886F3A" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid>
  </Border>
 </StackPanel>
</UserControl>